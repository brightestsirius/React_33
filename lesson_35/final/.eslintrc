// Налаштування ESLint — інструмента, який перевіряє JS-код на помилки та погані практики.
// Під час збірки його запускає EslintWebpackPlugin (див. webpack.config.js),
// а попередження й помилки з'являються в терміналі.
{
  // Як читати код
  "parserOptions": {
    // Підтримка сучасного синтаксису JS (зокрема динамічного import())
    "ecmaVersion": 2023,
    // Файли — ES-модулі, тобто в них є import / export
    "sourceType": "module"
  },

  // Власні правила: "off" — вимкнено, "warn" — попередження, "error" — помилка
  "rules": {
    // Змінна оголошена, але ніде не використовується
    "no-unused-vars": "warn",
    // У коді залишився console.log
    "no-console": "warn"
  },

  // Середовище: які глобальні змінні вже існують і не вважаються помилкою
  "env": {
    // Сучасний JS: Promise, Map, Set тощо
    "es6": true,
    // Браузер: window, document, fetch тощо
    "browser": true
  },

  // Готовий набір рекомендованих правил від ESLint
  "extends": [
    "eslint:recommended"
  ]
}
